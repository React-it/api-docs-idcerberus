  /api/customer:
    get:
      tags:
        - Customers
      summary: Query customer
      x-mint:
        href: /en/api-reference/customers/consultar-cliente
        metadata:
          title: Query customer
          sidebarTitle: Query customer
      description: |
        Queries registered customers by CPF or CNPJ provided in
        `documentKey`.

        Use this endpoint to check whether a customer already exists,
        retrieve its `tokenCustomer`, and query its current activation
        status.
      security:
        - bearerAuth: []
      parameters:
        - name: documentKey
          in: query
          required: true
          description: Customer's CPF or CNPJ.
          schema:
            type: string
          example: cpf or cnpj
      responses:
        '200':
          description: Customer found.
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Customer'
              example:
                - tokenCustomer: 00000000-0000-0000-0000-000000000000
                  type: PF
                  documentKey: 00000000-0000-0000-0000-000000000000
                  name: CUSTOMER NAME
                  addInformation: Cliente cadastrado via integração
                  active: false
                  imageUrl: https://exemplo.com/imagem-cliente.jpg
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /api/changeStatusOfCustomer:
    post:
      tags:
        - Customers
      summary: Change customer status
      x-mint:
        href: /en/api-reference/customers/alterar-status-de-cliente
        metadata:
          title: Change customer status
          sidebarTitle: Change customer status
      description: |
        Changes the active or inactive status of one or more customers.

        Send a list of objects with `documentKey` and `active`. Use `active:
        true` to activate and `active: false` to deactivate the customer.
      security:
        - bearerAuth: []
      requestBody:
        description: List of customers whose status should be changed.
        required: true
        content:
          application/json:
            schema:
              type: array
              items:
                $ref: '#/components/schemas/ChangeCustomerStatusRequest'
            example:
              - documentKey: 00000000-0000-0000-0000-000000000000
                active: false
      responses:
        '200':
          description: Status changed successfully.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericStatusResponse'
              example:
                status:
                  code: 200
                  message: Success
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  responses:
    BadRequest:
      description: Invalid payload, missing parameter, or technical processing failure.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          example:
            status:
              code: 400
              message: Failed to fetch information
    Unauthorized:
      description: Missing, invalid, or expired token.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          example:
            status:
              code: 401
              message: Unauthorized
    Forbidden:
      description: Valid credentials, but without permission to run the operation or service.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          example:
            status:
              code: 403
              message: Forbidden
    InvalidService:
      description: Service doesn't exist, isn't enabled, or was sent with an incorrect name.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          examples:
            serviceAusente:
              summary: Missing service field
              value:
                result: {}
                status:
                  code: 400
                  message: Campo service é obrigatório.
            serviceInvalido:
              summary: Unrecognized service
              value:
                result: {}
                status:
                  code: 400
                  message: Serviço não disponível para este cliente.
    ExternalSourceError:
      description: Temporary or technical failure in the external source queried.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          example:
            result: {}
            status:
              code: 500
              message: Failed to fetch information

  schemas:
    TokenRequest:
      type: object
      description: Application credentials used to generate a JWT token.
      required:
        - client
        - secret
      properties:
        client:
          type: string
          description: Application identifier provided previously.
        secret:
          type: string
          description: Application secret provided previously.

    TokenResponse:
      type: object
      description: Token generation response.
      properties:
        access_token:
          type: string
          description: JWT token used in the `Authorization` header.
        expires_in:
          type: string
          description: Token expiration time, in seconds.

    TokenOnboardingRequest:
      type: object
      properties:
        document:
          type: string
          description: CPF or CNPJ used in the onboarding.
        cpf:
          type: string
        cnpj:
          type: string
        name:
          type: string
        documentFiles:
          type: array
          items:
            type: object
            properties:
              documentFileType:
                type: string
                enum:
                  - RG_FRONT
                  - RG_BACK
                  - CNH
                  - SELFIE
                  - SELFIE_3D
                  - OAB_FRONT
                  - OAB_BACK
                  - OTHER
                  - OTHER_SINGLE_FILE
              document:
                type: string
                description: File in base64.
              documentUrl:
                type: string
                description: File URL.

    TokenOnboardingResponse:
      type: object
      properties:
        tokenOnboarding:
          type: string
          description: Onboarding UUID.
        dateHourProcess:
          type: string
          description: Date and time the TokenOnboarding was created.

    OnboardingReportResponse:
      type: object
      properties:
        tokenOnboarding:
          type: string
        createdDate:
          type: string
        numberSteps:
          type: integer
        status:
          type: string
          enum:
            - APPROVED
            - IN_PROCESS
            - REFUSED
        result:
          type: string
          enum:
            - AUT_APPROVED
            - IN_PROCESS
            - REFUSED
        fields:
          type: array
          items:
            $ref: '#/components/schemas/OnboardingField'
        services:
          type: array
          items:
            $ref: '#/components/schemas/OnboardingService'

    OnboardingField:
      type: object
      properties:
        field:
          type: string
        name:
          type: string
        step:
          type: string
        value:
          type: string

    OnboardingService:
      type: object
      properties:
        serviceName:
          type: string
        createdDate:
          type: string
        status:
          type: string
        statusMessage:
          type: string
        fields:
          type: array
          items:
            $ref: '#/components/schemas/OnboardingField'
        rules:
          type: array
          items:
            type: object
            properties:
              name:
                type: string
              value:
                type: string

    ServiceApiRequest:
      type: object
      description: |
        Base payload for the `/api/service-api` endpoint. The `service` field
        defines which product will run; the other fields are dynamic and
        depend on the service chosen.

        Main families:

        - PF registration and identity
        - Documents and biometrics
        - PF risk, validations, and compliance
        - Political and electoral
        - PJ registration and compliance status
        - PJ business owners, relationships, and compliance
      required:
        - service
      additionalProperties: true
      properties:
        service:
          type: string
          description: Code of the service that will run.
          example: SERVICE_PERSON_DATA_ENRICHMENT
        cpf:
          type: string
          description: CPF used in individual (PF) queries.
          example: cpf
        cnpj:
          type: string
          description: CNPJ used in business (PJ) queries.
          example: cnpj
        email:
          type: string
          description: Email used in email address validation.
          example: email@email.com
        phone:
          type: string
          description: Phone used in contact queries and validations.
          example: "11900000000"
        zipcode:
          type: string
          description: ZIP code used in address validations.
          example: 00000-000
        numberAddress:
          type: string
          description: Address number used in residence validations.
          example: "13"
        uf:
          type: string
          description: State (UF) when the service requires a state-level scope.
          example: SP
        image1:
          type: string
          description: Base64 image or main content for OCR, biometrics, and FaceMatch services.
          example: base64
        image2:
          type: string
          description: Second base64 image, when the service requires a comparison or the back of a document.
          example: base64
        image1Url:
          type: string
          description: URL of the first image, when the integration uses a hosted file.
          example: url_image
        image2Url:
          type: string
          description: URL of the second image, when the integration uses a hosted file.
          example: urlImageMatch
        selfie1:
          type: string
          description: Base64 selfie used in documentoscopy or face comparison.
          example: base64
        key:
          type: string
          description: Query key used in asynchronous services, such as digital documentoscopy.
          example: de0cd562-5962-40bd-8f94-5a7184ecde0e
        nit:
          type: string
          description: Worker identification number, when applicable.

    ServiceApiResponse:
      type: object
      description: |
        Standard response for external services. The `result` object changes
        depending on the service run, and `status` reports the query's
        technical result.

        Supporting schemas for the main returns are documented in this
        reference's components, such as `PersonDataEnrichmentResult`,
        `RfbPfResult`, `OcrDocumentResult`, `FaceMatchResult`, `PepResult`,
        `CorporateDataEnrichmentResult`, `RfbPjResult`, and `ActiveDebtResult`.
      additionalProperties: true
      properties:
        result:
          type: object
          description: Business data returned by the query.
          additionalProperties: true
        status:
          $ref: '#/components/schemas/StatusResponse'
        externalId:
          type: string
          description: External identifier of the query, when returned.

    StatusResponse:
      type: object
      description: Common technical status used in API responses.
      properties:
        code:
          type: integer
          description: Technical processing code.
          example: 200
        message:
          type: string
          description: Technical processing message.
          example: Success

    GenericStatusResponse:
      type: object
      description: Generic response with technical status.
      properties:
        status:
          $ref: '#/components/schemas/StatusResponse'

    ErrorResponse:
      type: object
      description: Technical error or processing failure response.
      properties:
        result:
          type: object
          nullable: true
          additionalProperties: true
          description: Partial data returned, when it exists.
        status:
          $ref: '#/components/schemas/StatusResponse'
        externalId:
          type: string
          description: External identifier of the query, when returned.

    Customer:
      type: object
      description: Customer registered in the idCerberus database.
      properties:
        tokenCustomer:
          type: string
          description: Customer identifier token.
        type:
          type: string
          nullable: true
          description: Customer type, when available.
        documentKey:
          type: string
          description: CPF or CNPJ used as the customer key.
        name:
          type: string
          nullable: true
          description: Customer name, when available.
        addInformation:
          type: string
          nullable: true
          description: Additional information linked to the customer.
        active:
          type: boolean
          description: Indicates whether the customer is active.
        imageUrl:
          type: string
          nullable: true
          description: Image URL linked to the customer, when available.

    PersonDataEnrichmentResult:
      type: object
      description: Result of individual (PF) data enrichment.
      properties:
        cpf:
          type: string
        status:
          type: string
        statusDate:
          type: string
        name:
          type: string
        gender:
          type: string
        fatherName:
          type: string
        motherName:
          type: string
        birthdate:
          type: string
        birthCountry:
          type: string
        dead:
          type: boolean
        country:
          type: string
        fiscalRegion:
          type: string
        age:
          type: integer

    RfbPfResult:
      type: object
      description: Result of the CPF query at the Federal Revenue.
      properties:
        cpf:
          type: string
        status:
          type: string
        name:
          type: string
        birthDate:
          type: string
        dead:
          type: boolean
        origin:
          type: string
        age:
          type: integer

    OcrDocumentResult:
      type: object
      description: Document OCR result.
      properties:
        cpf:
          type: string
        name:
          type: string
        fatherName:
          type: string
        motherName:
          type: string
        birthdate:
          type: string
        cnhCategory:
          type: string
        cnhNumber:
          type: string
        expeditionDate:
          type: string
        rg:
          type: string
        rgUf:
          type: string
        doc:
          type: string
        side:
          type: string
        validDate:
          type: string

    FaceMatchResult:
      type: object
      description: Result of the facial comparison between two images.
      properties:
        status:
          type: string
        similarity:
          type: number
          format: float

    PepResult:
      type: object
      description: Result of the Politically Exposed Person query.
      properties:
        cpf:
          type: string
        status:
          type: string

    CorporateDataEnrichmentResult:
      type: object
      description: Result of business (PJ) data enrichment.
      properties:
        cnpj:
          type: string
        status:
          type: string
        statusDate:
          type: string
        name:
          type: string
        country:
          type: string
        fantasyName:
          type: string
        origin:
          type: string
        regime:
          type: string
        age:
          type: integer
        foundedDate:
          type: string
        legalNatureCode:
          type: string
        legalNatureActivity:
          type: string
        capitalRS:
          type: string

    RfbPjResult:
      type: object
      description: Result of the CNPJ query at the Federal Revenue.
      properties:
        cnpj:
          type: string
        status:
          type: string
        statusDate:
          type: string
        origin:
          type: string

    ActiveDebtResult:
      type: object
      description: Result of the active debts query.
      properties:
        totalDebtValue:
          type: number
        totalDebts:
          type: integer
        debts:
          type: array
          items:
            type: object
            properties:
              source:
                type: string
              debtOrigin:
                type: string
              consolidatedValue:
                type: string
              responsibleUnity:
                type: string
              responsibleUnityUF:
                type: string
              registrationNumber:
                type: string
              registrationSituationType:
                type: string
              registrationSituation:
                type: string

    ChangeCustomerStatusRequest:
      type: object
      required:
        - documentKey
        - active
      properties:
        documentKey:
          type: string
          description: Customer identifier.
        active:
          type: boolean
          description: Defines whether the customer should be active or inactive.
