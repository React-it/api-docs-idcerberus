openapi: 3.0.0

info:
  title: idCerberus API
  version: 1.0.0
  description: |
    Technical reference for the idCerberus API, for integrating digital
    onboarding, KYC, biometrics, fraud prevention, risk analysis, compliance,
    registration enrichment, and individual and business query products.

    Use this reference when you already know which endpoint or service you
    want to implement. To understand flows, environments, best practices, and
    how to choose between services, see the guides first.

    Most data queries run through `POST /api/service-api`. On this endpoint,
    the route stays the same and the product run is defined by the `service`
    field sent in the body.

    In practice, the central endpoint works as a product runner: the method,
    URL, and headers are the same; what changes is the `service` value and
    the chosen product's required fields.

    The value sent in `service` needs to exist in the product enabled for the
    client. In some products, the calling alias configured for the product is
    shorter than another alias shown in the catalog. In those cases, send the
    calling alias in the body.

    1. Individual services usually use `cpf`.
    2. Business services usually use `cnpj`.
    3. Biometric and document services use base64 images or URLs.
    4. Some services require complementary fields, like `birthDate`, `uf`,
       `rg`, `phone`, `email`, `image1`, or `image2`.

    If you're unsure which `service` to use, see the guides "Choose the right
    service", "Service matrix", and "Service index".

    Useful search terms: CPF Federal Revenue, RFB PF, CNPJ Federal Revenue,
    RFB PJ, KYC PF, KYC PJ, OCR, FaceMatch, Liveness, fraud score, financial
    risk, electoral data, active debts, and protests.

servers:
  - url: https://backoffice-hml.idcerberus.com
    description: Staging environment
  - url: https://backoffice.idcerberus.com
    description: Production environment

tags:
  - name: Authorization
    description: |
      Generate the JWT token used in protected calls. Before consuming
      onboarding, external services, or customers, generate a token with
      `client` and `secret` and send it in the `Authorization` header.
  - name: SDK Integration
    description: |
      Endpoints used in the onboarding-via-SDK flow. Use this section to
      generate the `tokenOnboarding`, query the processed result, and
      download the final PDF report.
  - name: Services - Individuals
    description: |
      Individual services run through `POST /api/service-api`. Includes CPF
      enrichment, Federal Revenue, OCR, biometrics, FaceMatch, Liveness,
      risk, compliance, certificates, contacts, electoral data, and other
      products defined by the `service` field.
  - name: Services - Businesses
    description: |
      Business services run through `POST /api/service-api`. Includes CNPJ
      enrichment, Federal Revenue, SINTEGRA, business owners, relationships,
      debts, protests, business owners' KYC, and compliance.
  - name: Customers
    description: |
      Operations to query registered customers and change the active or
      inactive status of one or more records.

paths:
  /api/token-generate:
    post:
      tags:
        - Authorization
      summary: Generate API token
      x-mint:
        href: /en/api-reference/autorização/gerar-token-de-api
        metadata:
          title: Generate API token
          sidebarTitle: Generate API token
      description: |
        Generates the JWT token used in protected calls to the idCerberus API.

        Send the `client` and `secret` provided by idCerberus. The response
        contains `access_token` and `expires_in`. Use the returned token in
        the header:

        `Authorization: Bearer {jwt_token}`

        When the token expires, generate a new one using the same credentials.

        Available environments:

        | Environment | URL |
        | --- | --- |
        | Staging | `https://backoffice-hml.idcerberus.com/api/token-generate` |
        | Production | `https://backoffice.idcerberus.com/api/token-generate` |
      requestBody:
        description: |
          Send the application's credentials to generate a JWT token.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRequest'
            example:
              client: "{client}"
              secret: "{secret}"
      responses:
        '201':
          description: Token generated successfully.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenResponse'
              example:
                access_token: "{jwt_token}"
                expires_in: "300"
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'

  /api/token-history-onboarding:
    post:
      tags:
        - SDK Integration
      summary: Generate TokenOnboarding for SDK
      x-mint:
        href: /en/api-reference/integração-via-sdk/gerar-tokenonboarding-para-sdk
        metadata:
          title: Generate TokenOnboarding for SDK
          sidebarTitle: Generate TokenOnboarding for SDK
      description: |
        Creates a new `tokenOnboarding` to start a registration flow via SDK.

        The generated token should be handed to the SDK and will later be
        used to query the result processed by the backoffice and download
        the PDF report.

        Use `documentFiles` when you want to send documents or file URLs
        already at the start of the process.
      security:
        - bearerAuth: []
      requestBody:
        description: |
          Provide the user's initial data and, when applicable, files or
          document URLs that should be linked to the onboarding.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenOnboardingRequest'
            example:
              document: cpf
              cpf: cpf
              cnpj: cnpj
              name: name
              documentFiles:
                - documentFileType: OTHER
                  document: data:image/jpeg;base64
                  documentUrl: url
      responses:
        '200':
          description: TokenOnboarding generated successfully.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenOnboardingResponse'
              example:
                tokenOnboarding: 56950dae-2d19-4092-a918-a612b3ca8f68
                dateHourProcess: 2023-02-17T16:49:41.577364Z
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /api/onboarding/report/{tokenOnboarding}:
    get:
      tags:
        - SDK Integration
      summary: Query onboarding result
      x-mint:
        href: /en/api-reference/integração-via-sdk/consultar-resultado-de-onboarding
        metadata:
          title: Query onboarding result
          sidebarTitle: Query onboarding result
      description: |
        Returns the status, result, captured fields, and services run in an
        onboarding.

        Provide the `tokenOnboarding` generated earlier and handed to the SDK.
        The response can include data captured during registration, document
        URLs, processing messages, evaluated rules, and the status of the
        services run.

        Use this endpoint when you need to query the onboarding's structured
        result in JSON.
      security:
        - bearerAuth: []
      parameters:
        - name: tokenOnboarding
          in: path
          required: true
          description: UUID of the onboarding returned to the SDK.
          schema:
            type: string
      responses:
        '200':
          description: Onboarding result.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OnboardingReportResponse'
              example:
                tokenOnboarding: bb6adc72-0132-4b27-a723-98fe9f20cb81
                createdDate: 2022-06-15T19:02:04.877688Z
                numberSteps: 4
                status: APPROVED
                result: AUT_APPROVED
                fields:
                  - field: selfie_liveness_3d
                    name: Selfie Liveness 3D
                    step: "1"
                    value: https://bucket-onboarding.s3.amazonaws.com/arquivo
                  - field: button_cnh
                    name: CNH - Carteira Nacional de Habilitação
                    step: "2"
                services:
                  - serviceName: service_liveness_ft
                    createdDate: 2022-06-15T19:02:06.233020Z
                    status: APPROVED
                    statusMessage: USER PASSED THE LIVENESS CHALLENGE
                    fields: []
                    rules: []
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /api/history-onboarding-report/{tokenOnboarding}:
    get:
      tags:
        - SDK Integration
      summary: Download onboarding PDF report
      x-mint:
        href: /en/api-reference/integração-via-sdk/baixar-relatório-pdf-do-onboarding
        metadata:
          title: Download onboarding PDF report
          sidebarTitle: Download onboarding PDF report
      description: |
        Downloads the onboarding's final report in PDF.

        This endpoint doesn't return a JSON body. Use it when you need to
        store, audit, or present the registration process's final report.
      security:
        - bearerAuth: []
      parameters:
        - name: tokenOnboarding
          in: path
          required: true
          description: UUID of the onboarding returned to the SDK.
          schema:
            type: string
      responses:
        '200':
          description: PDF file of the report.
          content:
            application/pdf:
              schema:
                type: string
                format: binary
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /api/service-api:
    post:
      tags:
        - Services - Individuals
        - Services - Businesses
      summary: Run data, risk, or compliance service
      x-mint:
        href: /en/api-reference/serviços--pessoas/executar-serviço-de-dados-risco-ou-compliance
        metadata:
          title: Run data, risk, or compliance service
          sidebarTitle: Run data, risk, or compliance service
      description: |
        Central endpoint for running data, risk, biometrics, document, and
        compliance products for individuals and businesses.

        The route is always `POST /api/service-api`. The product run is
        defined by the `service` field sent in the body. The other fields
        vary depending on the service chosen.

        The `service` value is validated against the services enabled for the
        client's product. If the product is configured with a short alias,
        use that alias in the body, even if the catalog shows another
        documented alias.

        Common calling-alias examples:

        | Service |
        | --- |
        | `SERVICE_DIGITAL_DOCUMENTOSCOPY` | `SERVICE_DOCUMENTOSCOPY` |
        | `SERVICE_DIGITAL_DOCUMENTOSCOPY_CONSULT` | `SERVICE_DIGITAL_DOCUMENTOSCOPY` |
        | `SERVICE_ECONOMIC_RELATIONSHIP` | `economic_relationships` |
        | `SERVICE_EMAIL_VALIDATION` | `SERVICE_EMAIL_VALIDATION1` |
        | `SERVICE_PROTEST_CLEARANCE_CERTIFICATE`, `SERVICE_PROTEST_PF` | `SERVICE_PROTEST_CLEARANCE_CERTIFICATE` |
        | `SERVICE_PROTEST_PJ` | `SERVICE_PROTEST_CLEARANCE_CERTIFICATE_PJ` |

        This endpoint serves both individual and business services. In the
        examples, use the items prefixed `PF -` for CPF queries and the items
        prefixed `PJ -` for CNPJ queries.

        Most common fields:

        | Field | Use |
        | --- | --- |
        | `service` | Code of the product that will run |
        | `cpf` | Main document in individual services |
        | `cnpj` | Main document in business services |
        | `image1`, `image2` | Base64 images for OCR, biometrics, or documents |
        | `image1Url`, `image2Url` | Image URLs, when the service accepts a URL |
        | `selfie1` | Selfie used in documentoscopy and FaceMatch |
        | `key` | Query key used in asynchronous flows |

        Examples:

        1. CPF queries usually use `cpf`;
        2. CNPJ queries usually use `cnpj`;
        3. OCR, FaceMatch, and documentoscopy use base64 images or a URL;
        4. asynchronous services use `key` to query the result afterward.
        5. short payloads help validate access to the product, but document,
           OCR, and biometric services need real data to return complete
           results.

        Most responses return:

        1. `result`: the query's business data;
        2. `status.code`: technical processing code;
        3. `status.message`: technical processing message;
        4. `externalId`: external identifier, when available.

        Use this operation's example list to quickly pick the desired
        product's payload.
      security:
        - bearerAuth: []
      requestBody:
        description: |
          Provide the service code in the `service` field and the parameters
          required by that query. The `service` field is required in all
          cases. The other fields depend on the product selected.

          Use the examples to copy the desired service's initial payload.
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ServiceApiRequest'
            examples:
              enriquecimentoPessoaFisica:
                summary: PF - Data enrichment
                value:
                  service: SERVICE_PERSON_DATA_ENRICHMENT
                  cpf: cpf
              statusCpfReceitaFederal:
                summary: PF - CPF status at the Federal Revenue
                value:
                  service: SERVICE_RFB_PF
                  cpf: cpf
                  birthDate: yyyy-MM-dd (optional)
              statusCpfReceitaFederalOnDemand:
                summary: PF - CPF at the Federal Revenue on-demand
                value:
                  service: SERVICE_RFB_PF_ON_DEMAND
                  cpf: cpf
              cartaoSus:
                summary: PF - SUS card
                value:
                  service: SERVICE_ONDEMAND_SUS_CARD_PERSON_CPF
                  cpf: cpf
              modelagemDadosPessoa:
                summary: PF - Data modeling
                value:
                  service: SERVICE_PERSON_DATA_MODELING
                  cpf: cpf
              promptIaPessoa:
                summary: PF - AI prompt for a person
                value:
                  service: SERVICE_PERSON_AI_PROMPT
                  cpf: cpf
              ocrDocumentos:
                summary: PF - React OCR
                value:
                  service: SERVICE_OCR
                  documentType: IDENTIFICATION_DOCUMENT
                  image1: base64
                  image2: base64 (optional)
              faceMatch:
                summary: PF - FaceMatch
                value:
                  service: SERVICE_FACE_MATCH
                  image1: base64
                  image2: base64
              emailsPessoasRelacionadas:
                summary: PF - Related people's emails
                value:
                  service: SERVICE_RELATED_PEOPLE_EMAILS
                  cpf: cpf
              telefonesPessoasRelacionadas:
                summary: PF - Related people's phones
                value:
                  service: SERVICE_RELATED_PEOPLE_PHONES
                  cpf: cpf
              enderecosPessoasRelacionadas:
                summary: PF - Related people's addresses
                value:
                  service: SERVICE_RELATED_PEOPLE_ADDRESSES
                  cnpj: cnpj
              scoreCreditoPf:
                summary: PF - Credit score
                value:
                  service: SERVICE_QUOD_CREDIT_SCORE_PERSON
                  cpf: cpf
              scoreCreditoMultidadosPf:
                summary: PF - Multi-data credit score
                value:
                  service: SERVICE_BOAVISTA_ONE_SCORE_PERSON
                  cpf: cpf
              dadosRestritivosPf:
                summary: PF - Restrictive data
                value:
                  service: SERVICE_BOAVISTA_CREDIT_SCORE_PERSON
                  cpf: cpf
              flagsNegativosPf:
                summary: PF - Negative flags
                value:
                  service: SERVICE_QUOD_CREDIT_RISK_PERSON
                  cpf: cpf
              tseLocalVotacao:
                summary: PF - TSE - Polling place
                value:
                  service: SERVICE_ONDEMAND_TSE_POLLING_PLACE_PERSON_CPF
                  cpf: cpf
                  birthDate: yyyy-MM-dd (optional)
                  motherName: mother's name (optional)
              pessoaPoliticamenteExposta:
                summary: PF - Politically exposed person
                value:
                  service: SERVICE_PEP
                  cpf: cpf
