                  zipcode: 00000-000
                  numberAddress: 13
              documentoscopiaDigital:
                summary: PF - Digital document analysis
                value:
                  service: SERVICE_DIGITAL_DOCUMENTOSCOPY
                  key: 84bfcd2e-2336-4e30-bcab-15348b7890b5
                  image1: base64
                  image2: base64
                  selfie1: base64
              resultadoDocumentoscopiaDigital:
                summary: PF - Digital document analysis result
                value:
